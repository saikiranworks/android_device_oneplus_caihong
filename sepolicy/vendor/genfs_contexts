# The suspend HAL resolves /sys/class/wakeup/wakeup55 to this ADSP glink
# device path before reading wakelock stats. Label it like the other
# wakeup sources so system_suspend can read them (it already has
# r_dir_file(system_suspend, sysfs_wakeup) from AOSP policy).
genfscon sysfs /devices/platform/soc/3000000.remoteproc-adsp/remoteproc/remoteproc2/3000000.remoteproc-adsp:glink-edge/3000000.remoteproc-adsp:glink-edge.adsp_apps.-1.-1/wakeup u:object_r:sysfs_wakeup:s0
